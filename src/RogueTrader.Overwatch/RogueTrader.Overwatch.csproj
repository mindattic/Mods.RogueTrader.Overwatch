<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game paths and references, the shared runtime helpers and release packaging come from Mods.RogueTrader.Shared,
       checked out next to this repo. -->
  <PropertyGroup>
    <RogueTraderShared Condition="'$(RogueTraderShared)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\Mods.RogueTrader.Shared')">$(MSBuildThisFileDirectory)..\..\..\Mods.RogueTrader.Shared</RogueTraderShared>
    <!-- From a worktree under <repo>\.worktrees\<name> the sibling checkout is two levels further up. -->
    <RogueTraderShared Condition="'$(RogueTraderShared)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\Mods.RogueTrader.Shared</RogueTraderShared>
  </PropertyGroup>
  <Import Project="$(RogueTraderShared)\RogueTrader.Mod.props" />

  <PropertyGroup>
    <AssemblyName>RogueTrader.Overwatch</AssemblyName>
    <RootNamespace>RogueTraderOverwatch</RootNamespace>
    <ModSource>$(MSBuildThisFileDirectory)..\..\mod</ModSource>
    <ModFolderName>RogueTrader.Overwatch</ModFolderName>
    <!-- An Owlcat-format mod: RogueTrader.OwlcatMod.targets guarantees its Bundles folder and checks its settings
         at build. mod/Bundles/.keep also ships the folder as a real, tracked file (RTO-T104, RTS-T9). -->
    <OwlcatModification>true</OwlcatModification>
    <ModInstallDir>$(GameDataDir)\Modifications\$(ModFolderName)</ModInstallDir>
    <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ModSource)\OwlcatModificationManifest.json')), '"Version":\s*"([^"]+)"').Groups[1].Value)</ModVersion>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(ModSource)\**\*" />
    <!-- Only the in-game icons (the names Icons.cs maps); Header.png and Logo.png are for the Nexus page. -->
    <IconName Include="ReflexShot;Overwatch;OverwatchShots;Suppression;Suppressed;Hustle" />
    <IconFile Include="@(IconName->'$(MSBuildThisFileDirectory)..\..\assets\%(Identity).png')" />
  </ItemGroup>

  <!-- The mod folder the game loads: mod\ as-is, this assembly under Assemblies\ and the icons under Icons\.
       dotnet build -c Release then zips it to dist\ (RogueTrader.Package.targets). -->
  <Target Name="InstallMod" AfterTargets="Build">
    <RemoveDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="@(ModFile)" DestinationFiles="@(ModFile->'$(ModInstallDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)\Assemblies" />
    <Copy SourceFiles="@(IconFile)" DestinationFolder="$(ModInstallDir)\Icons" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Enable-Mod.ps1&quot; -GameDataDir &quot;$(GameDataDir)&quot; -Name $(ModFolderName)" />
    <Message Importance="high" Text="Installed to $(ModInstallDir)" />
    <!-- Proof the install really landed: the installed DLL's write time, so it's obvious in the build output
         whether the running game (once restarted) will pick up this build or a stale one. -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Write-Host ('Deployed DLL last written: ' + (Get-Item '$(ModInstallDir)\Assemblies\RogueTrader.Overwatch.dll').LastWriteTime)&quot;" />
  </Target>

</Project>
